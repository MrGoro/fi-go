# Environment for Playwright E2E runs (vite --mode e2e).
# Points the app at the local Firebase emulators using a `demo-` project,
# which keeps the emulators fully offline (no real credentials needed).
VITE_USE_FIREBASE_EMULATOR=true
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-fi-go.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=http://127.0.0.1:9000/?ns=demo-fi-go-default-rtdb
VITE_FIREBASE_PROJECT_ID=demo-fi-go
VITE_FIREBASE_STORAGE_BUCKET=demo-fi-go.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:demoe2e
